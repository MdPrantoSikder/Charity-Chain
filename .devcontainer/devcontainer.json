{
  "name": "CharityChain",
  "image": "mcr.microsoft.com/devcontainers/universal:2-linux",
  "hostRequirements": { "cpus": 4, "memory": "16gb" },
  "forwardPorts": [8000, 8545, 5432],
  "portsAttributes": {
    "8000": { "label": "CharityChain API", "visibility": "public" },
    "8545": { "label": "Besu JSON-RPC", "visibility": "public" }
  },
  "postCreateCommand": "pip install -r backend/requirements.txt",
  "remoteUser": "codespace"
}
